  pets:
  - id: fox
    name: "\u0424\u0438\u043D\u0438\u043A"
    description: "\u041B\u044E\u0431\u043E\u043F\u044B\u0442\u043D\u044B\u0439 \u0438 \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043A \u0440\u0435\u0448\u0435\u043D\u0438\u044F\u043C"
    accusative: "\u0424\u0438\u043D\u0438\u043A\u0430"
    role: "\u0418\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C"
    quote: "\u041E\u0431\u043E\u0436\u0430\u044E \u0443\u0437\u043D\u0430\u0432\u0430\u0442\u044C, \u043E\u0442\u043A\u0443\u0434\u0430 \u0431\u0435\u0440\u0443\u0442\u0441\u044F \u043C\u043E\u043D\u0435\u0442\u043A\u0438 \u0438 \u043A\u0443\u0434\u0430 \u043E\u043D\u0438 \u0443\u0431\u0435\u0433\u0430\u044E\u0442!"
    traits: 030000000200000002000000i
    avatar: {fileID: 21300000, guid: 0a274207a722ef947b4bda1d956b8043, type: 3}
    fullBody: {fileID: 0}
    nameIdeas:
    - "\u0424\u0438\u043D\u0438\u043A"
    - "\u041F\u0438\u043A\u0441\u0435\u043B\u044C"
    - "\u0424\u043B\u044D\u0448"
    - "\u041B\u043E\u043A\u043A\u0438"
    has3DModel: 1
  - id: cat
    name: "\u041A\u043E\u043F\u0435\u0439\u043A\u0430"
    description: "\u0421\u043F\u043E\u043A\u043E\u0439\u043D\u0430\u044F, \u043B\u044E\u0431\u0438\u0442 \u043F\u043E\u0440\u044F\u0434\u043E\u043A \u0438 \u043F\u043B\u0430\u043D\u044B"
    accusative: "\u041A\u043E\u043F\u0435\u0439\u043A\u0443"
    role: "\u041F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0449\u0438\u0446\u0430"
    quote: "\u041B\u044E\u0431\u043B\u044E, \u043A\u043E\u0433\u0434\u0430 \u0432\u0441\u0451 \u043F\u043E \u043F\u043E\u043B\u043E\u0447\u043A\u0430\u043C: \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u043B\u0430\u043D, \u043F\u043E\u0442\u043E\u043C \u043F\u043E\u043A\u0443\u043F\u043A\u0438."
    traits: 010000000300000002000000i
    avatar: {fileID: 21300000, guid: 3ada167cce44ca945a47c588fc810d79, type: 3}
    fullBody: {fileID: 21300000, guid: 5ea4570008b4cec4f8cb82fbd9f42c65, type: 3}
    nameIdeas:
    - "\u041A\u043E\u043F\u0435\u0439\u043A\u0430"
    - "\u041C\u044F\u0442\u0430"
    - "\u041F\u0438\u043A\u0441\u0438"
    - "\u041B\u0443\u043D\u0430"
    has3DModel: 1
  - id: raccoon
    name: "\u0420\u0438\u043A"
    description: "\u041E\u0431\u043E\u0436\u0430\u0435\u0442 \u0432\u044B\u0433\u043E\u0434\u043D\u044B\u0435 \u0438 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u044F"
    accusative: "\u0420\u0438\u043A\u0430"
    role: "\u041E\u0445\u043E\u0442\u043D\u0438\u043A \u0437\u0430 \u0432\u044B\u0433\u043E\u0434\u043E\u0439"
    quote: "\u041D\u0430\u0439\u0434\u0443, \u0433\u0434\u0435 \u0434\u0435\u0448\u0435\u0432\u043B\u0435 \u0438 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u0435\u0435. \u041D\u0438 \u043E\u0434\u043D\u0430 \u043C\u043E\u043D\u0435\u0442\u043A\u0430 \u043D\u0435 \u043F\u0440\u043E\u043F\u0430\u0434\u0451\u0442 \u0437\u0440\u044F!"
    traits: 020000000100000003000000i
    avatar: {fileID: 21300000, guid: 587b698de0a062848b5c1b9ca05e8594, type: 3}
    fullBody: {fileID: 21300000, guid: c22bd003bb2706d498a2a8cb4af44b11, type: 3}
    nameIdeas:
